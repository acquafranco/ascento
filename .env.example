APP_NAME=Ascento
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# PRODUCCIÓN: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning,
# SESSION_SECURE_COOKIE=true, APP_URL con https.
# --------------------------------------------------------------------------
# SESSION_SECURE_COOKIE=true

# SuperAdmin (lo crea database/seeders/SuperAdminSeeder.php)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Meta / WhatsApp Business
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
# Secret con el que Meta firma los webhooks (X-Hub-Signature-256).
# Si se deja vacío se usa FACEBOOK_CLIENT_SECRET. Sin ninguno de los dos,
# el webhook rechaza todo (los botones de WhatsApp no operan).
WHATSAPP_APP_SECRET=

# Mercado Pago (suscripción mensual). Credenciales de la aplicación NUEVA:
# Tus integraciones → tu app → Credenciales de producción (o de prueba).
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones → Webhooks → Clave secreta. URL a configurar ahí:
#   https://<tu-dominio>/api/mercadopago/webhook  (evento: Planes y suscripciones)
MERCADOPAGO_WEBHOOK_SECRET=
# Solo con credenciales de PRUEBA: email del usuario de prueba comprador.
# En producción dejarlo vacío.
MERCADOPAGO_TEST_PAYER_EMAIL=

# Geoapify (mapa de edificios y buscador de direcciones). Esta key es SOLO
# del servidor: nunca llega al navegador.
# Crear la key en https://myprojects.geoapify.com. Sin key, el mapa usa los
# mosaicos públicos de OpenStreetMap y los edificios quedan "pendientes de ubicar".
GEOAPIFY_API_KEY=
GEOAPIFY_COUNTRY_CODE=ar
GEOAPIFY_MIN_CONFIDENCE=0.8
GEOAPIFY_DAILY_LIMIT=1500
GEOAPIFY_MAP_STYLE=osm-bright
# OPCIONAL. Vacía, el mapa usa OpenStreetMap y funciona igual de rápido.
# Solo si querés el estilo de mapa de Geoapify: creá una SEGUNDA key en
# Geoapify restringida a tu dominio (va al navegador; la de arriba no).
GEOAPIFY_MAP_KEY=

# Notificaciones push (Web Push / VAPID) para admins, técnicos y clientes del portal.
# Generarlas UNA vez por entorno con: php artisan webpush:vapid
# (las escribe en .env). Si se cambian, cada técnico tiene que volver a
# activar las notificaciones. La privada nunca va al navegador.
VAPID_SUBJECT=mailto:soporte@tu-dominio.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram (canal adicional de avisos). Crear el bot con @BotFather, pegar el
# token y una clave secreta inventada (letras, números, _ y -), y después
# correr una vez: php artisan telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Avisos en tiempo real (Laravel Reverb). Sin estas claves la app funciona
# igual y los avisos se actualizan al recargar. Producción: ver
# docs/operacion-produccion.md (daemon de Reverb y proxy de Nginx).
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=ascento.online
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_ALLOWED_ORIGINS=ascento.online

# Videos de reportes (Profesional y Empresa). FFmpeg es opcional: si está,
# los videos se comprimen a 720p en segundo plano.
MEDIA_VIDEO_MAX_MB=50
MEDIA_VIDEO_MAX_SECONDS=120
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe

# Backups (base + archivos). La contraseña cifra el .zip (AES-256): guardala
# también FUERA del servidor, sin ella el backup no se puede abrir.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=
# BACKUP_MYSQLDUMP=mysqldump
# BACKUP_MYSQL=mysql
